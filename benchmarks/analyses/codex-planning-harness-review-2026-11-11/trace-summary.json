                    "step_id": "install-build-tools",
                    "role": "dependency",
                    "command": "if ! command -v gcc >/dev/null 2>&1 || ! command -v make >/dev/null 2>&1 || ! command -v autoconf >/dev/null 2>&1 || ! command -v autoreconf >/dev/null 2>&1 || ! command -v automake >/dev/null 2>&1 || ! autoconf --version | head -n1 | awk '{split($NF,v,\".\"); exit !(v[1]>2 || (v[1]==2 && v[2]>=70))}'; then apt-get update && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends build-essential autoconf automake; fi",
