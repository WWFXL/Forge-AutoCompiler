{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "forge-progress-aware-harness-comparison-v1",
  "type": "object",
  "required": [
    "identity",
    "issue",
    "branch",
    "parent",
    "historical_controls",
    "authorization",
    "environment",
    "provider",
    "budget",
    "evidence_root",
    "components",
    "source_archives",
    "tasks",
    "canary_checkpoints",
    "formal_schedule",
    "qualification"
  ],
  "properties": {
    "identity": {"const": "cpp-progress-aware-harness-comparison-v1"},
    "issue": {"const": 433},
    "branch": {"const": "yiwei/433-h0-h1-provider-comparison"},
    "evidence_root": {"type": "string", "minLength": 1},
    "tasks": {"type": "array", "minItems": 9, "maxItems": 9},
    "source_archives": {"type": "object", "minProperties": 9, "maxProperties": 9},
    "canary_checkpoints": {"type": "array", "minItems": 3, "maxItems": 3},
    "formal_schedule": {"type": "array", "minItems": 27, "maxItems": 27}
  },
  "additionalProperties": true
}
