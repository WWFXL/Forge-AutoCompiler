{
  "$id": "https://github.com/WWFXL/Forge-AutoCompiler/benchmarks/schemas/forge-jev-natural-failure-source-qualification-v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schema_version",
    "identity",
    "issue_url",
    "branch",
    "design_revision",
    "implementation_revision",
    "source_pool",
    "parents",
    "environment",
    "initial_paths",
    "budget",
    "qualification",
    "evidence",
    "authorization",
    "interpretation"
  ],
  "properties": {
    "$schema": {
      "const": "../schemas/forge-jev-natural-failure-source-qualification-v1.schema.json"
    },
    "schema_version": {
      "const": "forge-jev-natural-failure-source-qualification-1.0.0"
    },
    "identity": {
      "const": "cpp-jev-natural-failure-source-qualification-v1"
    },
    "issue_url": {
      "const": "https://github.com/WWFXL/Forge-AutoCompiler/issues/411"
    },
    "branch": {
      "const": "yiwei/411-jev-natural-failures"
    },
    "design_revision": {
      "pattern": "^[0-9a-f]{40}$"
    },
    "implementation_revision": {
      "type": ["string", "null"],
      "pattern": "^[0-9a-f]{40}$"
    },
    "source_pool": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "task_count"],
      "properties": {
        "path": {"type": "string"},
        "sha256": {"pattern": "^[0-9a-f]{64}$"},
        "task_count": {"const": 22}
      }
    },
    "parents": {
      "type": "object",
      "minProperties": 4,
      "additionalProperties": {"pattern": "^[0-9a-f]{64}$"}
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["compile_image", "image_id", "build_network", "parallel_jobs"],
      "properties": {
        "compile_image": {"const": "autocompiler:gcc13"},
        "image_id": {"pattern": "^sha256:[0-9a-f]{64}$"},
        "build_network": {"const": "none"},
        "parallel_jobs": {"const": 4}
      }
    },
    "initial_paths": {"type": "object"},
    "budget": {
      "type": "object",
      "required": ["replicates_per_task", "clone_timeout_seconds", "submodule_timeout_seconds", "command_timeout_seconds", "session_timeout_seconds", "total_wall_clock_seconds", "provider_requests", "model_tokens", "retries"],
      "properties": {
        "replicates_per_task": {"const": 2},
        "clone_timeout_seconds": {"type": "integer", "minimum": 1},
        "submodule_timeout_seconds": {"type": "integer", "minimum": 1},
        "command_timeout_seconds": {"type": "integer", "minimum": 1},
        "session_timeout_seconds": {"type": "integer", "minimum": 1},
        "total_wall_clock_seconds": {"type": "integer", "minimum": 1},
        "provider_requests": {"const": 0},
        "model_tokens": {"const": 0},
        "retries": {"const": 0}
      },
      "additionalProperties": false
    },
    "qualification": {"type": "object"},
    "evidence": {
      "type": "object",
      "required": ["root", "work_root", "report_json", "report_markdown", "create_once", "preserve_failures"],
      "properties": {
        "root": {"type": "string"},
        "work_root": {"type": "string"},
        "report_json": {"type": "string"},
        "report_markdown": {"type": "string"},
        "create_once": {"const": true},
        "preserve_failures": {"const": true}
      },
      "additionalProperties": false
    },
    "authorization": {
      "type": "object",
      "required": ["execution", "docker_execution", "formal_attempts", "formal_evidence_write", "credential_reads", "provider_calls", "historical_evidence_write", "replacement", "backfill"],
      "properties": {
        "execution": {"type": "boolean"},
        "docker_execution": {"const": true},
        "formal_attempts": {"type": "integer", "minimum": 0, "maximum": 1},
        "formal_evidence_write": {"type": "boolean"},
        "credential_reads": {"const": false},
        "provider_calls": {"const": false},
        "historical_evidence_write": {"const": false},
        "replacement": {"const": false},
        "backfill": {"const": false}
      },
      "additionalProperties": false
    },
    "interpretation": {
      "type": "object",
      "properties": {
        "source_qualification_only": {"const": true},
        "benchmark_qualified": {"const": false},
        "jev_effect": {"const": false},
        "agent_effect": {"const": false},
        "cost_savings_claim": {"const": false},
        "dynamic_budget_claim": {"const": false},
        "treatment_effect": {"const": false}
      },
      "additionalProperties": false,
      "required": ["source_qualification_only", "benchmark_qualified", "jev_effect", "agent_effect", "cost_savings_claim", "dynamic_budget_claim", "treatment_effect"]
    }
  }
}
