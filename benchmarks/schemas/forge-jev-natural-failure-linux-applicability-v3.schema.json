{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/WWFXL/Forge-AutoCompiler/benchmarks/schemas/forge-jev-natural-failure-linux-applicability-v3.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schema_version",
    "identity",
    "issue",
    "branch",
    "design_revision",
    "implementation_revision",
    "history_exclusion",
    "parents",
    "regression_fixture",
    "search",
    "source_contract",
    "selection",
    "budget",
    "authorization",
    "evidence",
    "interpretation"
  ],
  "properties": {
    "$schema": {"const": "../schemas/forge-jev-natural-failure-linux-applicability-v3.schema.json"},
    "schema_version": {"const": "forge-jev-natural-failure-linux-applicability-3.0.0"},
    "identity": {"const": "cpp-jev-natural-failure-linux-applicability-v3"},
    "issue": {"const": 415},
    "branch": {"const": "yiwei/415-linux-applicability-v3"},
    "design_revision": {"const": "97d70d490446c137b9d2f8385eb2a4191ac26d04"},
    "implementation_revision": {
      "oneOf": [
        {"type": "null"},
        {"type": "string", "pattern": "^[0-9a-f]{40}$"}
      ]
    },
    "history_exclusion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["revision", "v2_catalog_path", "v2_catalog_sha256", "project_family_count", "canonical_sha256"],
      "properties": {
        "revision": {"const": "97d70d490446c137b9d2f8385eb2a4191ac26d04"},
        "v2_catalog_path": {"const": "benchmarks/reports/cpp-jev-natural-failure-source-catalog-v2.json"},
        "v2_catalog_sha256": {"const": "5ac8824a17bbc72307c39df0f0605284a03897f0149bfc9ecca9b7aab13887f8"},
        "project_family_count": {"const": 205},
        "canonical_sha256": {"const": "3364738d600b522e71d71e1858bdec4acdf3903005686f2fbde356cd5647934d"}
      }
    },
    "parents": {
      "type": "object",
      "minProperties": 5,
      "additionalProperties": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
    },
    "regression_fixture": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {"const": "benchmarks/fixtures/cpp-jev-linux-applicability-v3-regressions.json"},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "search": {
      "type": "object",
      "additionalProperties": false,
      "required": ["queries"],
      "properties": {
        "queries": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "language", "stars", "size_kib", "updated", "sort", "order", "limit"],
            "properties": {
              "id": {"enum": ["c", "cpp"]},
              "language": {"enum": ["C", "C++"]},
              "stars": {"const": "50..20000"},
              "size_kib": {"const": "<100000"},
              "updated": {"const": ">=2024-01-01"},
              "sort": {"const": "updated"},
              "order": {"const": "desc"},
              "limit": {"const": 100}
            }
          }
        }
      }
    },
    "source_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "systems",
        "root_markers",
        "submodules_allowed",
        "network_signal_names",
        "entry_signal_names",
        "linux_signal_names",
        "document_exclusion_signal_names",
        "max_entry_blob_bytes",
        "max_document_files"
      ],
      "properties": {
        "systems": {"const": ["cmake", "make", "autotools"]},
        "root_markers": {
          "const": {
            "cmake": ["CMakeLists.txt"],
            "make": ["GNUmakefile", "Makefile", "makefile"],
            "autotools": ["configure.ac", "configure.in"]
          }
        },
        "submodules_allowed": {"const": false},
        "network_signal_names": {"type": "array", "minItems": 6, "uniqueItems": true, "items": {"type": "string"}},
        "entry_signal_names": {"type": "array", "minItems": 10, "uniqueItems": true, "items": {"type": "string"}},
        "linux_signal_names": {"type": "array", "minItems": 3, "uniqueItems": true, "items": {"type": "string"}},
        "document_exclusion_signal_names": {"type": "array", "minItems": 3, "uniqueItems": true, "items": {"type": "string"}},
        "max_entry_blob_bytes": {"const": 1048576},
        "max_document_files": {"const": 6}
      }
    },
    "selection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["seed", "required_per_system", "pass_decision", "fail_decision"],
      "properties": {
        "seed": {"const": "forge-jev-natural-failure-linux-applicability-v3-2026-10-12"},
        "required_per_system": {"const": 12},
        "pass_decision": {"const": "proceed_to_natural_failure_build_reference_qualification_v3"},
        "fail_decision": {"const": "stop_natural_failure_linux_applicability_v3"}
      }
    },
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "request_timeout_seconds",
        "total_wall_clock_seconds",
        "repository_search_requests",
        "maximum_search_results",
        "build_commands",
        "docker_containers",
        "credential_reads",
        "provider_requests",
        "model_tokens"
      ],
      "properties": {
        "request_timeout_seconds": {"const": 60},
        "total_wall_clock_seconds": {"const": 7200},
        "repository_search_requests": {"const": 2},
        "maximum_search_results": {"const": 200},
        "build_commands": {"const": 0},
        "docker_containers": {"const": 0},
        "credential_reads": {"const": 0},
        "provider_requests": {"const": 0},
        "model_tokens": {"const": 0}
      }
    },
    "authorization": {
      "type": "object",
      "additionalProperties": false,
      "required": ["execution", "formal_attempts", "formal_evidence_write", "authorized_by", "authorized_at"],
      "properties": {
        "execution": {"type": "boolean"},
        "formal_attempts": {"enum": [0, 1]},
        "formal_evidence_write": {"type": "boolean"},
        "authorized_by": {"type": ["string", "null"]},
        "authorized_at": {"type": ["string", "null"]}
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["root", "report_json", "report_markdown"],
      "properties": {
        "root": {"const": ".compile-sessions/benchmark-evidence-jev-natural-failure-linux-applicability-v3"},
        "report_json": {"const": "benchmarks/reports/cpp-jev-natural-failure-linux-applicability-v3.json"},
        "report_markdown": {"const": "benchmarks/reports/cpp-jev-natural-failure-linux-applicability-v3.md"}
      }
    },
    "interpretation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_catalog_only",
        "linux_applicability_sufficient",
        "natural_failure_observed",
        "reference_closure_observed",
        "jev_effect_estimated",
        "agent_effect_estimated",
        "dynamic_budget_estimated"
      ],
      "properties": {
        "source_catalog_only": {"const": true},
        "linux_applicability_sufficient": {"const": false},
        "natural_failure_observed": {"const": false},
        "reference_closure_observed": {"const": false},
        "jev_effect_estimated": {"const": false},
        "agent_effect_estimated": {"const": false},
        "dynamic_budget_estimated": {"const": false}
      }
    }
  }
}
