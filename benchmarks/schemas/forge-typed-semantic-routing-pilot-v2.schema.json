      "task_ids": [
        "args",
        "yyjson",
        "hoextdown",
        "hiredis",
        "c-ares",
        "numactl"
      ]
    },
    "status": "authorized_zero_provider_pilot"
  },
  "title": "Forge typed semantic routing pilot v2"
}
