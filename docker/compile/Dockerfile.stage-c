FROM ubuntu@sha256:224a1869083a311ef3f13648a154ba79832fbef6364d31493642ca03082da254

ARG DEBIAN_FRONTEND=noninteractive
ARG UBUNTU_SNAPSHOT=20260925T000000Z

ENV TZ=Asia/Shanghai \
    LANG=C.UTF-8 \
    LC_ALL=C.UTF-8 \
    CC=gcc-13 \
    CXX=g++-13 \
    CMAKE_BUILD_PARALLEL_LEVEL=4 \
    CTEST_PARALLEL_LEVEL=4 \
    MAKEFLAGS=-j4

RUN set -eux; \
    printf 'Types: deb\nURIs: https://snapshot.ubuntu.com/ubuntu/%s/\nSuites: noble noble-updates noble-security\nComponents: main universe\nSigned-By: /usr/share/keyrings/ubuntu-archive-keyring.gpg\n' "$UBUNTU_SNAPSHOT" \
      > /etc/apt/sources.list.d/ubuntu.sources; \
    printf 'Acquire::Check-Valid-Until "false";\nAcquire::Retries "5";\nAcquire::http::Timeout "120";\nAcquire::https::Timeout "120";\n' \
      > /etc/apt/apt.conf.d/80-stage-c-snapshot; \
    apt-get update; \
    apt-get install -y --no-install-recommends \
      autoconf \
      automake \
      bash \
      bison \
      build-essential \
      ca-certificates \
      cmake \
      curl \
      file \
      flex \
      g++-13 \
      gcc-13 \
      git \
      libogg-dev \
      libtool \
      m4 \
      make \
      meson \
      nasm \
      ninja-build \
      patch \
      pkg-config \
      python3 \
      rsync \
      tar \
      xz-utils \
      yasm; \
    update-alternatives --install /usr/bin/gcc gcc /usr/bin/gcc-13 130; \
    update-alternatives --install /usr/bin/g++ g++ /usr/bin/g++-13 130; \
    rm -rf /var/lib/apt/lists/* /tmp/* /var/tmp/*

LABEL org.forge-autocompiler.stage-c="paired-calibration-v1" \
      org.forge-autocompiler.ubuntu-snapshot="20260925T000000Z"

WORKDIR /workspace

CMD ["bash"]
